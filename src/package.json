{
  "name": "rise-and-flour-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Rise & Flour — WordPress theme",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "sass scss/main.scss css/main.css --style=expanded --no-source-map",
    "build:min": "sass scss/main.scss css/main.css --style=compressed --no-source-map",
    "watch": "sass --watch scss/main.scss:css/main.css --style=expanded --no-source-map"
  },
  "devDependencies": {
    "sass": "^1.80.0"
  }
}
